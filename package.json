{
  "name": "thaitype-stack-spa-react-elysia-prisma-template",
  "description": "Production marketplace platform built with Next.js, Elysia, Prisma, and Better Auth",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./server/*",
    "#generated/*": "./generated/*",
    "#/*": "./app/*"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"bun run dev:frontend\" \"bun run dev:server\"",
    "dev:push": "bun run scripts/dev-push.ts",
    "dev:frontend": "cross-env NODE_ENV=development next dev --port 3000",
    "dev:server": "cross-env NODE_ENV=development bun run --watch server/index.ts",
    "start": "bun run scripts/start-production.ts",
    "start:frontend": "cross-env NODE_ENV=production next start --port 3000",
    "start:server": "cross-env NODE_ENV=production bun run server/index.ts",
    "jobs:worker": "bun run server/modules/jobs/worker.ts",
    "build": "next build",
    "build:all": "bunx prisma generate && next build",
    "preview": "next start --port 3000",
    "test": "vitest run --exclude \"**/e2e/**\"",
    "test:e2e": "bun run scripts/assert-e2e-database.ts && bun run db:migrate:deploy && bun run db:seed && playwright test",
    "test:push:http": "playwright test --config playwright.push-http.config.ts",
    "audit:i18n": "bun run scripts/i18n-audit.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed-bootstrap-master": "bun run scripts/seed-bootstrap-master.ts",
    "db:seed-demo-catalog": "bun run scripts/seed-demo-catalog.ts",
    "db:studio": "bunx prisma studio",
    "db:seed-admin": "bun run scripts/seed-admin.ts",
    "db:seed-catalog-mock": "bun run scripts/seed-catalog-mock.ts",
    "db:backup": "bun run scripts/db-backup.ts",
    "db:restore": "bun run scripts/db-restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@base-ui/react": "^1.7.0",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.19.0",
    "better-auth": "^1.7.1",
    "bullmq": "^5.81.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.33.0",
    "motion": "^12.43.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prismabox": "^1.1.26",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "^5.32.14",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.4",
    "jsdom": "^28.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "defu": "^6.1.7",
    "deepmerge-ts": "^8.0.0",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.21",
    "nanoid": "^5.1.16",
    "postcss": "^8.5.23",
    "undici": "^7.29.0",
    "valibot": "^1.4.2",
    "vite": "^8.0.16"
  }
}
