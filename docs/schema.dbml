Project marketplace {
  database_type: "PostgreSQL"
}

Enum role {
  USER
  ADMIN
}

Enum user_status {
  ACTIVE
  SUSPENDED
}

Enum shop_status {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  BANNED
  VACATION
}

Enum seller_application_status {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

Enum seller_business_type {
  INDIVIDUAL
  COMPANY
}

Enum seller_verification_status {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

Enum seller_kyc_document_type {
  ID_CARD
  BUSINESS_CERTIFICATE
  BANK_BOOK
  TAX_DOCUMENT
}

Enum seller_kyc_document_side {
  FRONT
  BACK
  EXTRA
}

Enum shop_staff_status {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

Enum shop_staff_role_type {
  OWNER
  ADMIN
  MANAGER
  SUPPORT
  WAREHOUSE
  ACCOUNTANT
}

Enum shop_address_type {
  PICKUP
  RETURN
  WAREHOUSE
  BILLING
}

Enum wallet_ledger_entry_type {
  order_earning
  commission_fee
  payout_reserved
  payout_paid
  payout_rejected
  refund_adjustment
  manual_adjustment
}

Enum payout_status {
  requested
  approved
  rejected
  paid
  cancelled
}

Enum seller_transaction_type {
  ORDER_EARNING
  COMMISSION_FEE
  PAYOUT_RESERVED
  PAYOUT_PAID
  PAYOUT_REJECTED
  REFUND_ADJUSTMENT
  MANUAL_ADJUSTMENT
}

Enum seller_transaction_status {
  PENDING
  AVAILABLE
  RESERVED
  SETTLED
  CANCELLED
}

Enum product_status {
  DRAFT
  ACTIVE
  ARCHIVED
}

Enum variant_status {
  ACTIVE
  INACTIVE
}

Enum cart_status {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

Enum checkout_status {
  OPEN
  RESERVED
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
  CANCELED
}

Enum reservation_status {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

Enum order_status {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELED
  REFUNDED
}

Enum payment_status {
  REQUIRES_ACTION
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

Enum fulfillment_status {
  PENDING
  PACKED
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELED
}

Enum shipment_status {
  PENDING_PACK
  PACKED
  PENDING
  READY
  SHIPPED
  DELIVERED
  CANCELED
}

Enum discount_type {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

Enum review_status {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

Enum refund_status {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

Enum return_status {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

Table users {
  id uuid [pk]
  email varchar [not null, unique]
  name varchar [not null]
  role role [not null, default: "USER"]
  status user_status [not null, default: "ACTIVE"]
  email_verified boolean [not null, default: false]
  phone varchar [unique]
  phone_verified boolean [not null, default: false]
  image varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token varchar [not null, unique]
  expires_at timestamp [not null]
  device_id varchar
  revoked_at timestamp
  ip_address varchar
  user_agent varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    user_id
    (device_id, user_id, revoked_at)
  }
}

Table accounts {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  account_id varchar [not null]
  provider_id varchar [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope varchar
  password varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    user_id
    (provider_id, account_id) [unique]
  }
}

Table verifications {
  id uuid [pk]
  identifier varchar [not null]
  value varchar [not null]
  expires_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
}

Table seller_profiles {
  id uuid [pk]
  user_id uuid [not null, unique, ref: > users.id]
  business_type seller_business_type [not null, default: "INDIVIDUAL"]
  verification_status seller_verification_status [not null, default: "UNVERIFIED"]
  legal_name varchar
  display_name varchar
  contact_email varchar
  contact_phone varchar
  national_id_hash varchar
  national_id_encrypted varchar
  national_id_last4 varchar
  max_shop_count int [not null, default: 5]
  company_name varchar
  company_registration_encrypted varchar
  company_registration_last4 varchar
  tax_id_encrypted varchar
  tax_id_last4 varchar
  bank_name varchar
  bank_account_name varchar
  bank_account_number_encrypted varchar
  bank_account_number_last4 varchar
  verified_at timestamp
  rejected_reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    verification_status
    business_type
    national_id_hash
  }
}

Table shops {
  id uuid [pk]
  owner_id uuid [not null, ref: > users.id]
  seller_profile_id uuid [not null, ref: > seller_profiles.id]
  seller_identity_hash varchar
  name varchar [not null]
  slug varchar [not null, unique]
  contact_email varchar [not null]
  contact_phone varchar [not null]
  description text
  logo_url varchar
  cover_url varchar
  status shop_status [not null, default: "PENDING"]
  suspended_reason text
  rejected_reason text
  approved_by_id uuid [ref: > users.id]
  approved_at timestamp
  rating_average decimal [not null, default: 0]
  rating_count int [not null, default: 0]
  follower_count int [not null, default: 0]
  product_count int [not null, default: 0]
  meta_title varchar
  meta_description varchar
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    owner_id
    seller_profile_id
    (seller_identity_hash, status)
    approved_by_id
    status
    slug
    contact_email
    contact_phone
    deleted_at
    (rating_average, rating_count)
  }
}

Table seller_applications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  shop_id uuid [unique, ref: > shops.id]
  seller_profile_id uuid [ref: > seller_profiles.id]
  status seller_application_status [not null, default: "DRAFT"]
  business_type seller_business_type [not null, default: "INDIVIDUAL"]
  shop_name varchar [not null]
  shop_slug varchar [not null]
  shop_contact_email varchar [not null]
  shop_contact_phone varchar [not null]
  legal_name varchar [not null]
  contact_email varchar [not null]
  contact_phone varchar [not null]
  national_id_hash varchar
  national_id_encrypted varchar
  national_id_last4 varchar
  company_registration_encrypted varchar
  company_registration_last4 varchar
  tax_id_encrypted varchar
  tax_id_last4 varchar
  bank_name varchar [not null]
  bank_account_name varchar [not null]
  bank_account_number_encrypted varchar [not null]
  bank_account_number_last4 varchar [not null]
  pickup_name varchar [not null]
  pickup_phone varchar
  pickup_line1 varchar [not null]
  pickup_line2 varchar
  pickup_city varchar [not null]
  pickup_region varchar
  pickup_postal_code varchar [not null]
  pickup_country varchar [not null, default: "TH"]
  submitted_at timestamp
  reviewed_at timestamp
  reviewed_by_id uuid [ref: > users.id]
  rejection_reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (user_id, status)
    (national_id_hash, status)
    (status, submitted_at)
    reviewed_by_id
    shop_slug
    shop_contact_email
    shop_contact_phone
    seller_profile_id
  }
}

Table seller_kyc_documents {
  id uuid [pk]
  application_id uuid [not null, ref: > seller_applications.id]
  upload_id uuid [not null, unique]
  document_type seller_kyc_document_type [not null]
  side seller_kyc_document_side [not null, default: "FRONT"]
  sort_order int [not null, default: 0]
  created_at timestamp [not null]

  indexes {
    (application_id, document_type, side) [unique]
    (application_id, document_type)
  }
}

Table shop_staff {
  id uuid [pk]
  shop_id uuid [not null, ref: > shops.id]
  user_id uuid [not null, ref: > users.id]
  role shop_staff_role_type [not null, default: "SUPPORT"]
  status shop_staff_status [not null, default: "INVITED"]
  invited_by_id uuid [ref: > users.id]
  joined_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (shop_id, user_id) [unique]
    (shop_id, role, status)
    (user_id, status)
    invited_by_id
  }
}

Table shop_staff_permissions {
  id uuid [pk]
  staff_id uuid [not null, ref: > shop_staff.id]
  permission varchar [not null]
  created_at timestamp [not null]

  indexes {
    (staff_id, permission) [unique]
    permission
  }
}

Table shop_settings {
  id uuid [pk]
  shop_id uuid [not null, unique, ref: > shops.id]
  auto_accept_order boolean [not null, default: false]
  allow_cod boolean [not null, default: false]
  chat_enabled boolean [not null, default: true]
  vacation_mode boolean [not null, default: false]
  default_shipping_provider varchar
  return_policy text
  shipping_policy text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 1]
}

Table shop_addresses {
  id uuid [pk]
  shop_id uuid [not null, ref: > shops.id]
  type shop_address_type [not null, default: "PICKUP"]
  contact_name varchar [not null]
  phone varchar
  line1 varchar [not null]
  line2 varchar
  city varchar [not null]
  region varchar
  postal_code varchar [not null]
  country varchar [not null, default: "TH"]
  latitude decimal
  longitude decimal
  is_default boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (shop_id, type)
    (shop_id, is_default)
  }
}

Table shop_wallets {
  id uuid [pk]
  shop_id uuid [not null, unique, ref: > shops.id]
  currency varchar [not null, default: "THB"]
  balance bigint [not null, default: 0]
  pending_balance bigint [not null, default: 0]
  withdrawable_balance bigint [not null, default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 1]

  indexes {
    (id, shop_id) [unique]
    shop_id
  }
}

Table wallet_ledger_entries {
  id uuid [pk]
  wallet_id uuid [not null]
  shop_id uuid [not null, ref: > shops.id]
  type wallet_ledger_entry_type [not null]
  amount bigint [not null]
  currency varchar [not null, default: "THB"]
  order_id uuid [ref: > orders.id]
  payout_id uuid [ref: > seller_payouts.id]
  refund_id uuid [ref: > refunds.id]
  description text
  metadata jsonb
  created_at timestamp [not null]
  version int [not null, default: 1]

  indexes {
    (wallet_id, created_at)
    (shop_id, created_at)
    (order_id, type)
    payout_id
    refund_id
  }
}

Table seller_payouts {
  id uuid [pk]
  wallet_id uuid [not null]
  shop_id uuid [not null, ref: > shops.id]
  amount bigint [not null]
  currency varchar [not null, default: "THB"]
  status payout_status [not null, default: "requested"]
  requested_by_id uuid [not null, ref: > users.id]
  approved_by_id uuid [ref: > users.id]
  rejected_by_id uuid [ref: > users.id]
  paid_by_id uuid [ref: > users.id]
  rejection_reason text
  requested_at timestamp [not null]
  approved_at timestamp
  rejected_at timestamp
  paid_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (wallet_id, status)
    (shop_id, status)
    (status, requested_at)
    requested_by_id
    approved_by_id
    rejected_by_id
    paid_by_id
  }
}

Table seller_transactions {
  id uuid [pk]
  wallet_id uuid [not null]
  seller_profile_id uuid [ref: > seller_profiles.id]
  shop_id uuid [not null, ref: > shops.id]
  type seller_transaction_type [not null]
  status seller_transaction_status [not null, default: "PENDING"]
  amount bigint [not null]
  currency varchar [not null, default: "THB"]
  order_id uuid [ref: > orders.id]
  payout_id uuid [ref: > seller_payouts.id]
  refund_id uuid [ref: > refunds.id]
  reference varchar
  description text
  metadata jsonb
  available_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (wallet_id, created_at)
    (seller_profile_id, created_at)
    (shop_id, created_at)
    (type, status)
    order_id
    payout_id
    refund_id
  }
}

Table categories {
  id uuid [pk]
  name varchar [not null]
  name_th varchar
  name_en varchar
  slug varchar [not null, unique]
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table products {
  id uuid [pk]
  shop_id uuid [not null, ref: > shops.id]
  seller_profile_id uuid [ref: > seller_profiles.id]
  seller_identity_hash varchar
  category_id uuid [ref: > categories.id]
  title varchar [not null]
  title_th varchar
  title_en varchar
  slug varchar [not null]
  description text
  description_th text
  description_en text
  status product_status [not null, default: "DRAFT"]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  indexes {
    (shop_id, slug)
    (seller_profile_id, status)
    (category_id, status)
    (shop_id, status)
    deleted_at
  }
}

Table product_variants {
  id uuid [pk]
  product_id uuid [not null, ref: > products.id]
  sku varchar [not null]
  title varchar [not null]
  title_th varchar
  title_en varchar
  price bigint [not null]
  currency varchar [not null, default: "THB"]
  status variant_status [not null, default: "ACTIVE"]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (product_id, sku) [unique]
    (product_id, status)
  }
}

Table inventory {
  id uuid [pk]
  variant_id uuid [not null, unique, ref: > product_variants.id]
  quantity_on_hand int [not null, default: 0]
  quantity_reserved int [not null, default: 0]
  reorder_level int [not null, default: 0]
  version int [not null, default: 1]
  updated_at timestamp [not null]
}

Table carts {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  status cart_status [not null, default: "ACTIVE"]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table cart_items {
  id uuid [pk]
  cart_id uuid [not null, ref: > carts.id]
  variant_id uuid [not null, ref: > product_variants.id]
  quantity int [not null]
  unit_price bigint [not null]
  currency varchar [not null, default: "THB"]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table checkouts {
  id uuid [pk]
  cart_id uuid [not null, ref: > carts.id]
  user_id uuid [not null, ref: > users.id]
  status checkout_status [not null, default: "OPEN"]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency varchar [not null, default: "THB"]
  expires_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table inventory_reservations {
  id uuid [pk]
  checkout_id uuid [not null, ref: > checkouts.id]
  order_id uuid [ref: > orders.id]
  inventory_id uuid [not null, ref: > inventory.id]
  quantity int [not null]
  status reservation_status [not null, default: "ACTIVE"]
  expires_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table orders {
  id uuid [pk]
  checkout_id uuid [not null, unique, ref: > checkouts.id]
  user_id uuid [not null, ref: > users.id]
  order_number varchar [not null, unique]
  status order_status [not null, default: "PENDING_PAYMENT"]
  payment_status payment_status [not null, default: "PENDING"]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null]
  currency varchar [not null, default: "THB"]
  shipping_name varchar [not null]
  shipping_phone varchar
  shipping_line1 varchar [not null]
  shipping_line2 varchar
  shipping_city varchar [not null]
  shipping_region varchar
  shipping_postal_code varchar [not null]
  shipping_country varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table shop_orders {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  shop_id uuid [not null, ref: > shops.id]
  status order_status [not null, default: "PENDING_PAYMENT"]
  fulfillment_status fulfillment_status [not null, default: "PENDING"]
  subtotal bigint [not null, default: 0]
  discount_total bigint [not null, default: 0]
  shipping_total bigint [not null, default: 0]
  tax_total bigint [not null, default: 0]
  grand_total bigint [not null, default: 0]
  currency varchar [not null, default: "THB"]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  version int [not null, default: 1]
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  shop_id uuid [not null, ref: > shops.id]
  variant_id uuid [not null, ref: > product_variants.id]
  product_title varchar [not null]
  product_slug varchar [not null]
  variant_title varchar [not null]
  variant_sku varchar [not null]
  shop_name varchar [not null]
  shop_slug varchar [not null]
  quantity int [not null]
  unit_price bigint [not null]
  line_total bigint [not null]
  currency varchar [not null, default: "THB"]
  fulfillment_status fulfillment_status [not null, default: "PENDING"]
}

Table payments {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  provider varchar [not null]
  provider_intent_id varchar [not null, unique]
  status payment_status [not null, default: "PENDING"]
  amount bigint [not null]
  currency varchar [not null]
  paid_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table payment_events {
  id uuid [pk]
  payment_id uuid [not null, ref: > payments.id]
  provider_event_id varchar [not null, unique]
  event_type varchar [not null]
  payload jsonb [not null]
  received_at timestamp [not null]
}

Table shipments {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  shop_id uuid [not null, ref: > shops.id]
  status shipment_status [not null, default: "PENDING_PACK"]
  carrier varchar
  provider_id uuid
  tracking_number varchar
  shipped_at timestamp
  delivered_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table shipment_items {
  id uuid [pk]
  shipment_id uuid [not null, ref: > shipments.id]
  order_item_id uuid [not null, ref: > order_items.id]
  quantity int [not null]
}

Table coupons {
  id uuid [pk]
  shop_id uuid [ref: > shops.id]
  code varchar [not null, unique]
  title_th varchar
  title_en varchar
  description_th text
  description_en text
  discount_type discount_type [not null]
  discount_value bigint
  discount_percent_bps int
  min_order bigint
  max_discount bigint
  starts_at timestamp
  ends_at timestamp
  usage_limit int
  per_user_limit int
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table coupon_redemptions {
  id uuid [pk]
  coupon_id uuid [not null, ref: > coupons.id]
  user_id uuid [not null, ref: > users.id]
  order_id uuid [not null, ref: > orders.id]
  redeemed_at timestamp [not null]
}

Table reviews {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  product_id uuid [not null, ref: > products.id]
  order_item_id uuid [not null, unique, ref: > order_items.id]
  rating int [not null]
  body text
  status review_status [not null, default: "PENDING"]
  moderated_at timestamp
  moderation_reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table refunds {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  payment_id uuid [not null, ref: > payments.id]
  return_request_id uuid [unique]
  status refund_status [not null, default: "PENDING"]
  amount bigint [not null]
  reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table return_requests {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  shop_id uuid [not null, ref: > shops.id]
  user_id uuid [not null, ref: > users.id]
  status return_status [not null, default: "REQUESTED"]
  reason text
  description text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table return_items {
  id uuid [pk]
  return_request_id uuid [not null, ref: > return_requests.id]
  order_item_id uuid [not null, ref: > order_items.id]
  quantity int [not null]
  condition varchar
}

Table chat_threads {
  id uuid [pk]
  buyer_id uuid [not null, ref: > users.id]
  shop_id uuid [not null, ref: > shops.id]
  last_message_at timestamp
  buyer_read_at timestamp
  seller_read_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table chat_messages {
  id uuid [pk]
  thread_id uuid [not null, ref: > chat_threads.id]
  sender_id uuid [not null, ref: > users.id]
  order_id uuid [ref: > orders.id]
  body text [not null]
  created_at timestamp [not null]
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  type varchar [not null]
  title varchar [not null]
  body text
  read_at timestamp
  created_at timestamp [not null]
}

