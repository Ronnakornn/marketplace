  updatedAt DateTime              @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ProductAnswer[]

  @@index([shopId, status, createdAt])
  @@index([productId, status, createdAt])
  @@index([shopId, status])
  @@index([userId, createdAt])
}

model ProductAnswer {
  id         String              @id @default(uuid()) @db.Uuid
  questionId String              @db.Uuid
  userId     String              @db.Uuid
  answer     String
  status     ProductAnswerStatus @default(PUBLISHED)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, status, createdAt])
  @@index([userId, createdAt])
}

model SystemSetting {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  value       Json
  valueType   SettingValueType @default(JSON)
  description String?
  isPublic    Boolean          @default(false)
  updatedById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublic])
}

model FeatureToggle {
  id          String             @id @default(uuid()) @db.Uuid
  key         String
  scope       FeatureToggleScope @default(GLOBAL)
  scopeId     String?            @db.Uuid
  isEnabled   Boolean            @default(false)
  config      Json?
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([key, scope, scopeId])
  @@index([scope, scopeId, isEnabled])
}

model NotificationTemplate {
  id        String                      @id @default(uuid()) @db.Uuid
  key       String
  channel   NotificationTemplateChannel
  locale    String                      @default("th")
  subject   String?
  body      String
  variables Json?
  isActive  Boolean                     @default(true)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@unique([key, channel, locale])
  @@index([channel, isActive])
}

model ReportExportJob {
  id            String             @id @default(uuid()) @db.Uuid
  requestedById String             @db.Uuid
  type          String
  format        ReportExportFormat @default(XLSX)
  status        ReportExportStatus @default(QUEUED)
  filters       Json?
  fileUrl       String?
  error         String?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  requestedBy User @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
  @@index([type, status, createdAt])
  @@index([status, createdAt])
}

model SearchQueryLog {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String?              @db.Uuid
  sessionId         String?
  query             String
  normalizedQuery   String
  resultCount       Int                  @default(0)
  clickedEntityType AnalyticsEntityType?
  clickedEntityId   String?              @db.Uuid
  ipHash            String?
  userAgentHash     String?
  metadata          Json?
  createdAt         DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalizedQuery, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([clickedEntityType, clickedEntityId])
  @@index([createdAt])
}

model ProductViewLog {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  shopId        String   @db.Uuid
  userId        String?  @db.Uuid
  sessionId     String?
  source        String?
  referrer      String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([shopId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model ShopViewLog {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @db.Uuid
  userId        String?  @db.Uuid
  sessionId     String?
  source        String?
  referrer      String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model ModerationCase {
  id             String                  @id @default(uuid()) @db.Uuid
  entityType     ModerationEntityType
  entityId       String                  @db.Uuid
  reason         ModerationCaseReason
  status         ModerationCaseStatus    @default(OPEN)
  severity       SellerViolationSeverity @default(MEDIUM)
  title          String?
  description    String?
  evidence       Json?
  sourceReportId String?                 @db.Uuid
  createdById    String?                 @db.Uuid
  assignedToId   String?                 @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  createdBy  User?              @relation("ModerationCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?              @relation("ModerationCaseAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  actions    ModerationAction[]

  @@index([entityType, entityId, status])
  @@index([status, severity, createdAt])
  @@index([entityType, entityId])
  @@index([status, severity, updatedAt])
  @@index([assignedToId, status])
  @@index([createdById, createdAt])
  @@index([reason, createdAt])
}

model ModerationAction {
  id        String               @id @default(uuid()) @db.Uuid
  caseId    String               @db.Uuid
  actorId   String               @db.Uuid
  action    ModerationActionType
  note      String?
  metadata  Json?
  createdAt DateTime             @default(now())

  case  ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model WebhookEvent {
  id             String             @id @default(uuid()) @db.Uuid
  provider       WebhookProvider
  eventType      String
  externalId     String?
  idempotencyKey String?
  status         WebhookEventStatus @default(RECEIVED)
  payload        Json
  headers        Json?
  signatureHash  String?
  attempts       Int                @default(0)
  lastError      String?
  processedById  String?            @db.Uuid
  processedAt    DateTime?
  receivedAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  processedBy User? @relation("WebhookEventProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@unique([provider, idempotencyKey])
  @@index([provider, status, receivedAt])
  @@index([provider, eventType, status, receivedAt])
  @@index([provider, eventType, receivedAt])
  @@index([status, receivedAt])
  @@index([processedById, processedAt])
}

model IntegrationLog {
  id           String               @id @default(uuid()) @db.Uuid
  provider     WebhookProvider
  direction    IntegrationDirection
  operation    String
  status       IntegrationLogStatus
  requestId    String?
  relatedType  String?
  relatedId    String?              @db.Uuid
  requestBody  Json?
  responseBody Json?
  statusCode   Int?
  errorCode    String?
  errorMessage String?
  durationMs   Int?
  retryCount   Int                  @default(0)
  createdAt    DateTime             @default(now())

  @@index([provider, status, createdAt])
  @@index([provider, operation, status, createdAt])
  @@index([provider, operation, createdAt])
  @@index([direction, status, createdAt])
  @@index([relatedType, relatedId])
  @@index([requestId])
  @@index([createdAt])
}
