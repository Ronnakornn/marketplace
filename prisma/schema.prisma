  PROCESSING
  SUCCESS
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum UploadUsage {
  PRODUCT_IMAGE
  PRODUCT_VIDEO
  SHOP_IMAGE
  REVIEW_IMAGE
  REVIEW_VIDEO
  KYC_DOCUMENT
}

enum UploadStatus {
  PENDING
  COMPLETED
}

enum AuditAction {
  USER_STATUS_CHANGED
  SELLER_APPLICATION_STATUS_CHANGED
  SELLER_PROFILE_STATUS_CHANGED
  SHOP_STATUS_CHANGED
  PRODUCT_STATUS_CHANGED
  ORDER_STATUS_CHANGED
  SHIPMENT_STATUS_CHANGED
  REFUND_STATUS_CHANGED
  RETURN_STATUS_CHANGED
  FRAUD_CASE_REVIEWED
  FRAUD_CASE_RESOLVED
  ADMIN_LOGIN
  ADMIN_CONFIG_CHANGED
}

enum ChatMessageType {
  TEXT
  IMAGE
}

enum WalletLedgerEntryType {
  order_earning
  commission_fee
  payout_reserved
  payout_paid
  payout_rejected
  refund_adjustment
  manual_adjustment
}

enum PayoutStatus {
  requested
  approved
  rejected
  paid
  cancelled
}

enum AffiliateStatus {
  ACTIVE
  DISABLED
}

enum AffiliateLinkStatus {
  ACTIVE
  DISABLED
}

enum AffiliateTargetType {
  product
  shop
  campaign
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  VOID
}

enum FraudEntityType {
  ORDER
  REFUND
  AFFILIATE
  COUPON
}

enum FraudRiskLevel {
  low
  medium
  high
  critical
}

enum FraudCaseStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  phone         String?    @unique @db.VarChar(32)
  phoneVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  addresses                       Address[]
  accounts                        Account[]
  cartItems                       Cart[]
  chatMessages                    ChatMessage[]
  chatThreads                     ChatThread[]
  chatThreadReadStates            ChatThreadReadState[]
  couponRedemptions               CouponRedemption[]
  favoriteProducts                FavoriteProduct[]
  followedShops                   ShopFollow[]
  notifications                   Notification[]
  orders                          Order[]
  returnRequests                  ReturnRequest[]
  reviews                         Review[]
  reviewMedia                     ReviewMedia[]            @relation("ReviewMediaUploadedBy")
  reviewReports                   ReviewReport[]           @relation("ReviewReportReportedBy")
  moderatedReviewReports          ReviewReport[]           @relation("ReviewReportModeratedBy")
  sessions                        Session[]
  shops                           Shop[]
  sellerProfile                   SellerProfile?
  sellerApplications              SellerApplication[]
  approvedShops                   Shop[]                   @relation("ShopApprovedBy")
  reviewedSellerApplications      SellerApplication[]      @relation("SellerApplicationReviewedBy")
  invitedShopStaffMemberships     ShopStaff[]              @relation("ShopStaffInvitedBy")
  requestedSellerPayouts          SellerPayout[]           @relation("SellerPayoutRequestedBy")
  approvedSellerPayouts           SellerPayout[]           @relation("SellerPayoutApprovedBy")
  rejectedSellerPayouts           SellerPayout[]           @relation("SellerPayoutRejectedBy")
  paidSellerPayouts               SellerPayout[]           @relation("SellerPayoutPaidBy")
  shopStaffMemberships            ShopStaff[]
  shopRatings                     ShopRating[]
  shopActivityLogs                ShopActivityLog[]
  reportedProductDuplicateReviews ProductDuplicateReview[] @relation("ProductDuplicateReportedBy")
  reviewedProductDuplicateReviews ProductDuplicateReview[] @relation("ProductDuplicateReviewedBy")
  checkouts                       Checkout[]
  uploads                         Upload[]
  affiliate                       Affiliate?
  affiliateClicks                 AffiliateClick[]
  fraudCases                      FraudCase[]
  reviewedFraudCases              FraudCase[]              @relation("FraudCaseReviewedBy")
  resolvedFraudCases              FraudCase[]              @relation("FraudCaseResolvedBy")
  auditLogs                       AuditLog[]
  internalNotes                   InternalNote[]
  sellerViolations                SellerViolation[]
  shopRestrictions                ShopRestriction[]
  deviceAccounts                  DeviceAccount[]
  idempotencyKeys                 IdempotencyKey[]
  buyerCoinWallet                 BuyerCoinWallet?
  buyerCoinLedgerEntries          BuyerCoinLedger[]
  supportTickets                  SupportTicket[]
  ticketMessages                  TicketMessage[]
  openedDisputeCases              DisputeCase[]            @relation("DisputeOpenedBy")
  productQuestions                ProductQuestion[]
  productAnswers                  ProductAnswer[]
  reportExportJobs                ReportExportJob[]
  searchQueryLogs                 SearchQueryLog[]
  productViewLogs                 ProductViewLog[]
  shopViewLogs                    ShopViewLog[]
  moderationCasesCreated          ModerationCase[]         @relation("ModerationCaseCreatedBy")
  moderationCasesAssigned         ModerationCase[]         @relation("ModerationCaseAssignedTo")
  moderationActions               ModerationAction[]
  webhookEvents                   WebhookEvent[]           @relation("WebhookEventProcessedBy")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  recipientName String
  phone         String?
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String
  country       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  deviceId  String?
  revokedAt DateTime?
  userId    String    @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId, userId, revokedAt])
}

model DeviceAccount {
  id          String    @id @default(uuid()) @db.Uuid
  deviceId    String
  userId      String    @db.Uuid
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  metadata    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, userId])
  @@index([deviceId, revokedAt])
  @@index([userId, revokedAt])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model PhoneOtpChallenge {
  id                String          @id @default(uuid()) @db.Uuid
  phone             String          @db.VarChar(32)
  purpose           PhoneOtpPurpose
  otpHash           String
  attempts          Int             @default(0)
  maxAttempts       Int             @default(5)
  resendAvailableAt DateTime
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
  @@index([phone, purpose, consumedAt, revokedAt, expiresAt])
}

model Shop {
  id                 String     @id @default(uuid()) @db.Uuid
  ownerId            String     @db.Uuid
  sellerProfileId    String     @db.Uuid
  sellerIdentityHash String?
  name               String
  slug               String
  contactEmail       String
  contactPhone       String
  description        String?
  logoUrl            String?
  coverUrl           String?
  status             ShopStatus @default(PENDING)
  suspendedReason    String?
  rejectedReason     String?
  approvedById       String?    @db.Uuid
  approvedAt         DateTime?
  ratingAverage      Decimal    @default(0) @db.Decimal(3, 2)
  ratingCount        Int        @default(0)
  followerCount      Int        @default(0)
  productCount       Int        @default(0)
  metaTitle          String?
  metaDescription    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  owner                   User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sellerProfile           SellerProfile            @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  approvedBy              User?                    @relation("ShopApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  chatThreads             ChatThread[]
  coupons                 Coupon[]
  followers               ShopFollow[]
  orderItems              OrderItem[]
  shopOrders              ShopOrder[]
  ratings                 ShopRating[]
  products                Product[]
  shipments               Shipment[]
  wallet                  ShopWallet?
  walletEntries           WalletLedgerEntry[]
  sellerTransactions      SellerTransaction[]
  productDuplicateReports ProductDuplicateReview[] @relation("ProductDuplicateReportedByShop")
  payouts                 SellerPayout[]
  sellerApplication       SellerApplication?
  staff                   ShopStaff[]
  settings                ShopSetting?
  addresses               ShopAddress[]
  dailyStats              ShopDailyStats[]
  activityLogs            ShopActivityLog[]
  sellerViolations        SellerViolation[]
  restrictions            ShopRestriction[]
  returnRequests          ReturnRequest[]
  shippingProviders       ShippingProvider[]
  flashSales              FlashSale[]
  flashSaleItems          FlashSaleItem[]
  supportTickets          SupportTicket[]
  productQuestions        ProductQuestion[]
  viewLogs                ShopViewLog[]
  productViewLogs         ProductViewLog[]

  @@index([ownerId])
  @@index([sellerProfileId])
  @@index([sellerIdentityHash, status])
  @@index([approvedById])
  @@index([status])
  @@index([slug])
  @@index([contactEmail])
  @@index([contactPhone])
  @@index([deletedAt])
  @@index([ratingAverage, ratingCount])
}

model SellerProfile {
  id                           String                   @id @default(uuid()) @db.Uuid
  userId                       String                   @unique @db.Uuid
  businessType                 SellerBusinessType       @default(INDIVIDUAL)
  verificationStatus           SellerVerificationStatus @default(UNVERIFIED)
  legalName                    String?
  displayName                  String?
  contactEmail                 String?
  contactPhone                 String?
  nationalIdHash               String?
  nationalIdEncrypted          String?
  nationalIdLast4              String?
  maxShopCount                 Int                      @default(5)
  companyName                  String?
  companyRegistrationEncrypted String?
  companyRegistrationLast4     String?
  taxIdEncrypted               String?
  taxIdLast4                   String?
  bankName                     String?
  bankAccountName              String?
  bankAccountNumberEncrypted   String?
  bankAccountNumberLast4       String?
  verifiedAt                   DateTime?
  rejectedReason               String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shops        Shop[]
  products     Product[]           @relation("ProductSellerProfile")
  applications SellerApplication[]
  transactions SellerTransaction[]

  @@index([verificationStatus])
  @@index([businessType])
  @@index([nationalIdHash])
}

model SellerApplication {
  id                           String                  @id @default(uuid()) @db.Uuid
  userId                       String                  @db.Uuid
  shopId                       String?                 @unique @db.Uuid
  sellerProfileId              String?                 @db.Uuid
  status                       SellerApplicationStatus @default(DRAFT)
  businessType                 SellerBusinessType      @default(INDIVIDUAL)
  shopName                     String
  shopSlug                     String
  shopContactEmail             String
  shopContactPhone             String
  legalName                    String
  contactEmail                 String
  contactPhone                 String
  nationalIdHash               String?
  nationalIdEncrypted          String?
  nationalIdLast4              String?
  companyRegistrationEncrypted String?
  companyRegistrationLast4     String?
  taxIdEncrypted               String?
  taxIdLast4                   String?
  bankName                     String
  bankAccountName              String
  bankAccountNumberEncrypted   String
  bankAccountNumberLast4       String
  pickupName                   String
  pickupPhone                  String?
  pickupLine1                  String
  pickupLine2                  String?
  pickupCity                   String
  pickupRegion                 String?
  pickupPostalCode             String
  pickupCountry                String                  @default("TH")
  submittedAt                  DateTime?
  reviewedAt                   DateTime?
  reviewedById                 String?                 @db.Uuid
  rejectionReason              String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop          Shop?               @relation(fields: [shopId], references: [id], onDelete: SetNull)
  sellerProfile SellerProfile?      @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  reviewedBy    User?               @relation("SellerApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents     SellerKycDocument[]

  @@index([userId, status])
  @@index([nationalIdHash, status])
  @@index([status, submittedAt])
  @@index([reviewedById])
  @@index([shopSlug])
  @@index([shopContactEmail])
  @@index([shopContactPhone])
  @@index([sellerProfileId])
}

model SellerKycDocument {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @db.Uuid
  uploadId      String                @unique @db.Uuid
  documentType  SellerKycDocumentType
  side          SellerKycDocumentSide @default(FRONT)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())

  application SellerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  upload      Upload            @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([applicationId, documentType, side])
  @@index([applicationId, documentType])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameTh    String?
  nameEn    String?
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Brand {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  nameTh        String?
  nameEn        String?
  slug          String   @unique
  code          String?  @unique
  description   String?
  descriptionTh String?
  descriptionEn String?
  logoUrl       String?
  websiteUrl    String?
  countryCode   String?
  sortOrder     Int      @default(0)
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@index([isActive, isFeatured, sortOrder])
  @@index([isActive, name])
  @@index([isActive, nameTh])
  @@index([isActive, nameEn])
  @@index([isActive, slug])
  @@index([countryCode, isActive])
}

model Product {
  id                     String                 @id @default(uuid()) @db.Uuid
  shopId                 String                 @db.Uuid
  sellerProfileId        String?                @db.Uuid
  sellerIdentityHash     String?
  categoryId             String?                @db.Uuid
  brandId                String?                @db.Uuid
  title                  String
  titleTh                String?
  titleEn                String?
  slug                   String
  description            String?
  descriptionTh          String?
  descriptionEn          String?
  metaTitle              String?
  metaDescription        String?
  warrantyInfo           String?
  condition              String?
  countryOfOrigin        String?
  status                 ProductStatus          @default(DRAFT)
  productFingerprintHash String?
  duplicateStatus        ProductDuplicateStatus @default(UNKNOWN)
  duplicateOfProductId   String?                @db.Uuid
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?

  category                    Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                       Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  shop                        Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sellerProfile               SellerProfile?           @relation("ProductSellerProfile", fields: [sellerProfileId], references: [id], onDelete: SetNull)
  duplicateOf                 Product?                 @relation("ProductDuplicateOf", fields: [duplicateOfProductId], references: [id], onDelete: SetNull)
  duplicatedBy                Product[]                @relation("ProductDuplicateOf")
  duplicateReviewsAsSource    ProductDuplicateReview[] @relation("ProductDuplicateSourceProduct")
  duplicateReviewsAsCandidate ProductDuplicateReview[] @relation("ProductDuplicateCandidateProduct")
  reviews                     Review[]
  flashSaleItems              FlashSaleItem[]
  productQuestions            ProductQuestion[]
  viewLogs                    ProductViewLog[]
  favorites                   FavoriteProduct[]
  variants                    ProductVariant[]
  images                      ProductImage[]
  video                       ProductVideo?
  highlights                  ProductHighlight[]
  attributes                  ProductAttribute[]
  chatMessages                ChatMessage[]
  // embeddings  ProductEmbedding[]

  @@index([status, deletedAt, createdAt])
  @@index([shopId, status, deletedAt, createdAt])
  @@index([categoryId, status, deletedAt, createdAt])
  @@index([brandId, status, deletedAt, createdAt])
  @@index([sellerProfileId, status, deletedAt, createdAt])
  @@index([shopId, slug])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([categoryId, brandId, status])
  @@index([shopId, status])
  @@index([sellerProfileId, status])
  @@index([sellerIdentityHash, productFingerprintHash])
  @@index([shopId, productFingerprintHash])
  @@index([productFingerprintHash])
  @@index([duplicateStatus])
  @@index([duplicateOfProductId])
  @@index([deletedAt])
}

model ProductHighlight {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductAttribute {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  attributeKey  String
  displayName   String
  displayNameTh String?
  displayNameEn String?
  value         String
  valueTh       String?
  valueEn       String?
  sortOrder     Int      @default(0)
  isFilterable  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeKey])
  @@index([productId, sortOrder])
  @@index([attributeKey, value])
  @@index([isFilterable, attributeKey, value])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  uploadId  String?  @db.Uuid
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  upload  Upload? @relation("ProductImageUpload", fields: [uploadId], references: [id], onDelete: SetNull)

  @@unique([uploadId])
  @@index([productId, sortOrder, createdAt])
  @@index([productId, isPrimary])
  @@index([uploadId])
}

model ProductVideo {
