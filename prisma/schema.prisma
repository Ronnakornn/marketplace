generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

generator prismabox {
  provider                    = "prismabox"
  output                      = "../generated/prismabox"
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PhoneOtpPurpose {
  PHONE_LOGIN
  PHONE_SIGNUP
  PHONE_LINK
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  BANNED
  VACATION
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum SellerBusinessType {
  INDIVIDUAL
  COMPANY
}

enum SellerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopStaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ShopStaffRoleType {
  OWNER
  ADMIN
  MANAGER
  SUPPORT
  WAREHOUSE
  ACCOUNTANT
}

enum ShopAddressType {
  PICKUP
  RETURN
  WAREHOUSE
  BILLING
}

enum ShopActivityAction {
  SHOP_CREATED
  SHOP_UPDATED
  SHOP_STATUS_CHANGED
  SELLER_APPLICATION_SUBMITTED
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  STAFF_INVITED
  STAFF_UPDATED
  STAFF_REMOVED
  SETTINGS_UPDATED
  ADDRESS_CREATED
  ADDRESS_UPDATED
  ADDRESS_DELETED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_REJECTED
  PAYOUT_PAID
}

enum SellerViolationType {
  DUPLICATE_PRODUCT
  PROHIBITED_PRODUCT
  FAKE_REVIEW
  LATE_SHIPMENT
  CANCELLATION_ABUSE
  REFUND_ABUSE
  POLICY_VIOLATION
  FRAUD_RISK
  OTHER
}

enum SellerViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SellerViolationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum ShopRestrictionType {
  LISTING_DISABLED
  CHECKOUT_DISABLED
  PAYOUT_HOLD
  CHAT_DISABLED
  VISIBILITY_LIMITED
  FULL_SUSPENSION
}

enum SellerTransactionType {
  ORDER_EARNING
  COMMISSION_FEE
  PAYOUT_RESERVED
  PAYOUT_PAID
  PAYOUT_REJECTED
  REFUND_ADJUSTMENT
  MANUAL_ADJUSTMENT
}

enum SellerTransactionStatus {
  PENDING
  AVAILABLE
  RESERVED
  SETTLED
  CANCELLED
}

enum SellerKycDocumentType {
  ID_CARD
  BUSINESS_CERTIFICATE
  BANK_BOOK
  TAX_DOCUMENT
}

enum SellerKycDocumentSide {
  FRONT
  BACK
  EXTRA
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductDuplicateStatus {
  UNKNOWN
  UNIQUE
  SUSPECTED_DUPLICATE
  BLOCKED_DUPLICATE
  APPROVED_EXCEPTION
}

enum ProductDuplicateReviewStatus {
  OPEN
  APPROVED_DUPLICATE
  REJECTED_NOT_DUPLICATE
  APPROVED_EXCEPTION
  CLOSED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum CheckoutStatus {
  OPEN
  RESERVED
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
  CANCELED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_ACTION
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PACKED
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELED
}

enum ShipmentStatus {
  PENDING_PACK
  PACKED
  PENDING
  READY
  SHIPPED
  DELIVERED
  CANCELED
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

enum ReviewReportReason {
  SPAM
  ABUSIVE_LANGUAGE
  ADULT_CONTENT
  FAKE_REVIEW
  IRRELEVANT
  PERSONAL_INFO
  OTHER
}

enum ReviewReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REMOVED
  RESOLVED_DISMISSED
  RESOLVED_HIDDEN
}

enum RefundStatus {
