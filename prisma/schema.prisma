generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

generator prismabox {
  provider                    = "prismabox"
  output                      = "../generated/prismabox"
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum CheckoutStatus {
  OPEN
  RESERVED
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
  CANCELED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_ACTION
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PACKED
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELED
}

enum ShipmentStatus {
  PENDING_PACK
  PACKED
  PENDING
  READY
  SHIPPED
  DELIVERED
  CANCELED
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum UploadUsage {
  PRODUCT_IMAGE
  SHOP_IMAGE
  REVIEW_IMAGE
}

enum UploadStatus {
  PENDING
  COMPLETED
}

enum AuditAction {
  USER_STATUS_CHANGED
  SHOP_STATUS_CHANGED
  PRODUCT_STATUS_CHANGED
  ORDER_STATUS_CHANGED
  SHIPMENT_STATUS_CHANGED
  REFUND_STATUS_CHANGED
  RETURN_STATUS_CHANGED
  FRAUD_CASE_REVIEWED
  FRAUD_CASE_RESOLVED
  ADMIN_LOGIN
  ADMIN_CONFIG_CHANGED
}

enum ChatMessageType {
  TEXT
  IMAGE
}

enum WalletLedgerEntryType {
  order_earning
  commission_fee
  payout_reserved
  payout_paid
  payout_rejected
  refund_adjustment
  manual_adjustment
}

enum PayoutStatus {
  requested
  approved
  rejected
  paid
  cancelled
}

enum AffiliateStatus {
  ACTIVE
  DISABLED
}

enum AffiliateLinkStatus {
  ACTIVE
  DISABLED
}

enum AffiliateTargetType {
  product
  shop
  campaign
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  VOID
}

enum FraudEntityType {
  ORDER
  REFUND
  AFFILIATE
  COUPON
}

enum FraudRiskLevel {
  low
  medium
  high
  critical
}

enum FraudCaseStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  addresses         Address[]
  accounts          Account[]
  cartItems         Cart[]
  chatMessages      ChatMessage[]
  chatThreads       ChatThread[]
  couponRedemptions CouponRedemption[]
  favoriteProducts  FavoriteProduct[]
  followedShops     ShopFollow[]
  notifications     Notification[]
  orders            Order[]
  returnRequests    ReturnRequest[]
  reviews           Review[]
  sessions          Session[]
  shops             Shop[]
  checkouts         Checkout[]
  uploads           Upload[]
  affiliate         Affiliate?
  affiliateClicks   AffiliateClick[]
  fraudCases        FraudCase[]
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  recipientName String
  phone         String?
  line1         String
  line2         String?
  city          String
  region        String?
  postalCode    String
  country       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Shop {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @db.Uuid
  name      String
  slug      String     @unique
  status    ShopStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chatThreads ChatThread[]
  coupons     Coupon[]
  followers   ShopFollow[]
  orderItems  OrderItem[]
  products    Product[]
  shipments   Shipment[]
  wallet      SellerWallet?
  payouts     SellerPayout[]

  @@index([ownerId])
  @@index([status])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameTh    String?
  nameEn    String?
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  shopId        String        @db.Uuid
  categoryId    String?       @db.Uuid
  title         String
  titleTh       String?
  titleEn       String?
  slug          String
  description   String?
  descriptionTh String?
  descriptionEn String?
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviews     Review[]
  favorites   FavoriteProduct[]
  variants    ProductVariant[]
  chatThreads ChatThread[]
  embeddings  ProductEmbedding[]

  @@unique([shopId, slug])
  @@index([categoryId, status])
  @@index([shopId, status])
}

model ProductEmbedding {
  id          String                  @id @default(uuid()) @db.Uuid
  productId   String                  @db.Uuid
  locale      String                  @default("default")
  model       String
  contentHash String
  embedding   Unsupported("vector(1536)")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale, model])
  @@index([productId])
  @@index([model, locale])
}

model FavoriteProduct {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model ShopFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  shopId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId, createdAt])
  @@index([shopId])
}

model ProductVariant {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @db.Uuid
  sku        String        @unique
  title      String
  titleTh    String?
  titleEn    String?
  priceCents Int
  currency   String        @default("USD")
  status     VariantStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  inventory             Inventory?
  inventoryReservations InventoryReservation[]
  orderItems            OrderItem[]

  @@index([productId, status])
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  variantId        String   @unique @db.Uuid
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(0)
  updatedAt        DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkouts Checkout[]
  items     CartItem[]

  @@index([userId, status])
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @db.Uuid
  variantId      String   @db.Uuid
  quantity       Int
  unitPriceCents Int
  currency       String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Checkout {
  id                 String         @id @default(uuid()) @db.Uuid
  cartId             String         @db.Uuid
  userId             String         @db.Uuid
  status             CheckoutStatus @default(OPEN)
  subtotalCents      Int            @default(0)
  discountTotalCents Int            @default(0)
  shippingTotalCents Int            @default(0)
  taxTotalCents      Int            @default(0)
  grandTotalCents    Int            @default(0)
  currency           String         @default("USD")
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  cart                  Cart                   @relation(fields: [cartId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  inventoryReservations InventoryReservation[]
  order                 Order?

  @@index([cartId])
  @@index([userId, status])
  @@index([status, expiresAt])
}

model InventoryReservation {
  id         String            @id @default(uuid()) @db.Uuid
  checkoutId String            @db.Uuid
  variantId  String            @db.Uuid
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  checkout Checkout       @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([checkoutId, variantId])
  @@index([variantId, status])
  @@index([status, expiresAt])
}

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  checkoutId         String        @unique @db.Uuid
  userId             String        @db.Uuid
  orderNumber        String        @unique
  status             OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus @default(PENDING)
  subtotalCents      Int           @default(0)
  discountTotalCents Int           @default(0)
  shippingTotalCents Int           @default(0)
  taxTotalCents      Int           @default(0)
  grandTotalCents    Int
  currency           String        @default("USD")
  shippingName       String
  shippingPhone      String?
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingRegion     String?
  shippingPostalCode String
  shippingCountry    String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  checkout            Checkout             @relation(fields: [checkoutId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  chatThreads         ChatThread[]
  couponRedemptions   CouponRedemption[]
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  returnRequests      ReturnRequest[]
  shipments           Shipment[]
  walletEntries       WalletLedgerEntry[]
  affiliateCommission AffiliateCommission?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  shopId            String            @db.Uuid
  variantId         String            @db.Uuid
  productTitle      String
  productSlug       String
  variantTitle      String
  variantSku        String
  shopName          String
  shopSlug          String
  quantity          Int
  unitPriceCents    Int
  lineTotalCents    Int
  currency          String            @default("USD")
  fulfillmentStatus FulfillmentStatus @default(PENDING)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop          Shop           @relation(fields: [shopId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  review        Review?
  returnItems   ReturnItem[]
  shipmentItems ShipmentItem[]

  @@index([orderId, shopId])
  @@index([shopId, fulfillmentStatus])
  @@index([variantId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @db.Uuid
  provider         String
  providerIntentId String        @unique
  status           PaymentStatus @default(PENDING)
  amountCents      Int
  currency         String
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId, status])
}

model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @db.Uuid
  providerEventId String   @unique
  eventType       String
  payload         Json
  receivedAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventType, receivedAt])
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  shopId         String         @db.Uuid
  status         ShipmentStatus @default(PENDING_PACK)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop  Shop           @relation(fields: [shopId], references: [id])
  items ShipmentItem[]

  @@unique([orderId, shopId])
  @@index([orderId, shopId])
  @@index([shopId, status])
  @@index([trackingNumber])
}

model ShipmentItem {
  id          String @id @default(uuid()) @db.Uuid
  shipmentId  String @db.Uuid
  orderItemId String @db.Uuid
  quantity    Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model Coupon {
  id                 String       @id @default(uuid()) @db.Uuid
  shopId             String?      @db.Uuid
  code               String       @unique
  titleTh            String?
  titleEn            String?
  descriptionTh      String?
  descriptionEn      String?
  discountType       DiscountType
  discountValueCents Int?
  discountPercentBps Int?
  minOrderCents      Int?
  maxDiscountCents   Int?
  startsAt           DateTime?
  endsAt             DateTime?
  usageLimit         Int?
  perUserLimit       Int?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  shop        Shop?              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@index([shopId])
  @@index([code])
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  userId     String   @db.Uuid
  orderId    String   @db.Uuid
  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  productId   String       @db.Uuid
  orderItemId String       @unique @db.Uuid
  rating      Int
  body        String?
  images      String[]     @default([])
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([userId])
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  paymentId       String       @db.Uuid
  returnRequestId String?      @unique @db.Uuid
  status          RefundStatus @default(PENDING)
  amountCents     Int
  reason          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment             @relation(fields: [paymentId], references: [id])
  returnRequest ReturnRequest?      @relation(fields: [returnRequestId], references: [id])
  walletEntries WalletLedgerEntry[]

  @@index([orderId, status])
  @@index([paymentId])
  @@index([returnRequestId])
}

model SellerWallet {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @unique @db.Uuid
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entries WalletLedgerEntry[]
  payouts SellerPayout[]

  @@index([shopId])
}

model WalletLedgerEntry {
  id          String                @id @default(uuid()) @db.Uuid
  walletId    String                @db.Uuid
  shopId      String                @db.Uuid
  type        WalletLedgerEntryType
  amountCents Int
  currency    String                @default("USD")
  orderId     String?               @db.Uuid
  payoutId    String?               @db.Uuid
  refundId    String?               @db.Uuid
  description String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  wallet SellerWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order?        @relation(fields: [orderId], references: [id])
  payout SellerPayout? @relation(fields: [payoutId], references: [id])
  refund Refund?       @relation(fields: [refundId], references: [id])

  @@index([walletId, createdAt])
  @@index([shopId, createdAt])
  @@index([orderId, type])
  @@index([payoutId])
  @@index([refundId])
}

model SellerPayout {
  id              String       @id @default(uuid()) @db.Uuid
  walletId        String       @db.Uuid
  shopId          String       @db.Uuid
  amountCents     Int
  currency        String       @default("USD")
  status          PayoutStatus @default(requested)
  requestedById   String       @db.Uuid
  approvedById    String?      @db.Uuid
  rejectedById    String?      @db.Uuid
  paidById        String?      @db.Uuid
  rejectionReason String?
  requestedAt     DateTime     @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  wallet  SellerWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  shop    Shop                @relation(fields: [shopId], references: [id])
  entries WalletLedgerEntry[]

  @@index([walletId, status])
  @@index([shopId, status])
  @@index([status, requestedAt])
}

model ReturnRequest {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  userId      String       @db.Uuid
  status      ReturnStatus @default(REQUESTED)
  reason      String?
  description String?
  images      String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId, status])
  @@index([userId, createdAt])
}

model ReturnItem {
  id              String  @id @default(uuid()) @db.Uuid
  returnRequestId String  @db.Uuid
  orderItemId     String  @db.Uuid
  quantity        Int
  condition       String?

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ChatThread {
  id           String    @id @default(uuid()) @db.Uuid
  buyerId      String    @db.Uuid
  shopId       String    @db.Uuid
  productId    String?   @db.Uuid
  orderId      String?   @db.Uuid
  buyerReadAt  DateTime?
  sellerReadAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  buyer    User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id])
  order    Order?        @relation(fields: [orderId], references: [id])
  messages ChatMessage[]

  @@unique([buyerId, shopId])
  @@index([buyerId, createdAt])
  @@index([shopId, createdAt])
  @@index([productId])
  @@index([orderId])
}

model ChatMessage {
  id          String          @id @default(uuid()) @db.Uuid
  threadId    String          @db.Uuid
  senderId    String          @db.Uuid
  messageType ChatMessageType @default(TEXT)
  body        String?
  attachments String[]        @default([])
  createdAt   DateTime        @default(now())

  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type])
}

model Upload {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  usage       UploadUsage
  status      UploadStatus @default(PENDING)
  fileName    String
  contentType String
  fileSize    Int
  key         String       @unique
  publicUrl   String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([usage, createdAt])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  actorRole   Role
  action      AuditAction
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FraudCase {
  id         String          @id @default(uuid()) @db.Uuid
  entityType FraudEntityType
  entityId   String
  userId     String?         @db.Uuid
  riskScore  Int
  riskLevel  FraudRiskLevel
  reasons    String[]        @default([])
  status     FraudCaseStatus @default(OPEN)
  metadata   Json?
  reviewedBy String?         @db.Uuid
  reviewedAt DateTime?
  resolvedBy String?         @db.Uuid
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId])
  @@index([status, riskLevel, createdAt])
  @@index([userId, createdAt])
  @@index([reviewedBy])
}

model Affiliate {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @unique @db.Uuid
  status    AffiliateStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  links       AffiliateLink[]
  clicks      AffiliateClick[]
  commissions AffiliateCommission[]

  @@index([status])
}

model AffiliateLink {
  id          String              @id @default(uuid()) @db.Uuid
  affiliateId String              @db.Uuid
  code        String              @unique
  targetType  AffiliateTargetType
  targetId    String
  status      AffiliateLinkStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clicks      AffiliateClick[]
  commissions AffiliateCommission[]

  @@index([affiliateId, createdAt])
  @@index([targetType, targetId])
  @@index([status])
}

model AffiliateClick {
  id            String   @id @default(uuid()) @db.Uuid
  affiliateId   String   @db.Uuid
  linkId        String   @db.Uuid
  buyerUserId   String?  @db.Uuid
  sessionId     String?
  refParam      String?
  ipHash        String?
  userAgentHash String?
  clickedAt     DateTime @default(now())
  expiresAt     DateTime

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  link        AffiliateLink         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  buyerUser   User?                 @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)
  commissions AffiliateCommission[]

  @@index([affiliateId, clickedAt])
  @@index([linkId, clickedAt])
  @@index([buyerUserId, clickedAt])
  @@index([sessionId, clickedAt])
  @@index([expiresAt])
}

model AffiliateCommission {
  id                    String                    @id @default(uuid()) @db.Uuid
  affiliateId           String                    @db.Uuid
  linkId                String                    @db.Uuid
  clickId               String?                   @db.Uuid
  orderId               String                    @unique @db.Uuid
  eligibleSubtotalCents Int
  commissionBps         Int
  commissionCents       Int
  currency              String                    @default("USD")
  status                AffiliateCommissionStatus @default(PENDING)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  affiliate Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  link      AffiliateLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  click     AffiliateClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([linkId, createdAt])
  @@index([status])
}
